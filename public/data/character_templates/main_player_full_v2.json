{
  "schema": 1,
  "id": "main_player_full_v2",
  "role": "player",
  "status": "generation_target",
  "extends": "data/character_templates/main_player_v1.json",
  "purpose": "Pack completo ad alta fluidità per tutti i prossimi protagonisti",
  "raster": {
    "canvas": [640, 420],
    "baseline_y": 400,
    "scale_mode": "baked",
    "runtime_scale": 1.0,
    "preview_fps": 12
  },
  "direction_policy": {
    "logical_directions": 8,
    "authored_clips": ["walk", "walk_up", "walk_down", "run", "run_up", "run_down"],
    "diagonals": "blend movement vector and select the closest authored depth clip",
    "allow_runtime_stretch": false
  },
  "required_clips": [
    "idle", "idle_variant_1", "idle_variant_2", "idle_variant_3", "idle_variant_4",
    "walk", "walk_up", "walk_down", "run", "run_up", "run_down", "brake",
    "jump", "land", "air_attack", "air_punch",
    "punch_left", "punch_right", "combo_finisher",
    "kick_front", "kick_right", "kick_finisher",
    "block", "dodge", "grab", "grab_strike", "throw", "super",
    "hit", "knockdown", "getup", "dead"
  ],
  "locomotion": {
    "idle": { "frames": 8, "loop": true },
    "walk": { "frames": 12, "loop": true },
    "walk_up": { "frames": 10, "loop": true },
    "walk_down": { "frames": 10, "loop": true },
    "run": { "frames": 10, "loop": true },
    "run_up": { "frames": 10, "loop": true },
    "run_down": { "frames": 10, "loop": true },
    "brake": { "frames": 6, "loop": false },
    "jump": { "frames": 10, "loop": false },
    "land": { "frames": 6, "loop": false }
  },
  "clip_targets": {
    "light_attack": { "minimum_frames": 8 },
    "finisher": { "minimum_frames": 10 },
    "aerial_attack": { "minimum_frames": 8 },
    "grab_or_throw": { "minimum_frames": 8 },
    "super": { "minimum_frames": 14 },
    "hit": { "minimum_frames": 5 },
    "knockdown": { "minimum_frames": 8 },
    "getup": { "minimum_frames": 8 },
    "dead": { "minimum_frames": 8 }
  },
  "personality_idles": {
    "required_count": 4,
    "minimum_frames_each": 16,
    "maximum_frames_each": 24,
    "duration_seconds": [3.5, 6.0],
    "must_return_to_base_idle": true,
    "allow_frame_blend": false,
    "concept_slots": [
      "character_pride_or_grooming",
      "signature_prop_inspection",
      "signature_prop_action",
      "comic_personality_beat"
    ]
  },
  "mandatory_transitions": [
    "idle_to_walk", "walk_to_idle", "walk_to_run", "run_to_brake",
    "run_to_jump", "jump_to_air_attack", "jump_to_land", "land_to_idle",
    "hit_to_knockdown", "knockdown_to_getup", "getup_to_idle"
  ],
  "qa": {
    "runtime_scale_locked": 1.0,
    "locked_scale_clips": ["knockdown", "getup", "dead"],
    "reject_exact_duplicates": true,
    "reject_near_duplicates": true,
    "reject_canvas_crop": true,
    "reject_bottom_opaque_cut": true,
    "max_upright_height_error_px": 6,
    "require_first_last_pose_compatibility": true
  }
}
