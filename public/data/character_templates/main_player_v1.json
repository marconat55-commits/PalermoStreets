    "jump": {
      "frames": 8,
      "loop": false,
      "phases": ["anticipation", "takeoff", "rise", "apex", "fall", "prepare_land", "landing", "recover"]
    },
    "land": {
      "frames": 4,
      "loop": false,
      "phases": ["contact", "compression", "recover", "guard"]
    }
  },
  "qa": {
    "upright_grounded_clips": ["idle", "walk", "walk_up", "walk_down"],
    "upright_grounded_prefixes": ["idle_variant_"],
    "unique_motion_clips": ["idle", "walk", "walk_up", "walk_down", "run", "brake", "jump", "land"],
    "unique_motion_prefixes": ["idle_variant_"],
    "distinct_motion_clips": ["walk", "walk_up", "walk_down", "run", "brake", "jump", "land"],
    "distinct_motion_prefixes": ["idle_variant_"],
    "min_silhouette_distance": 0.025,
    "max_visual_height_error_px": 6,
