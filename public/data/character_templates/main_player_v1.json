    "walk_down": {
      "frames": 6,
      "loop": true,
      "phases": ["left_contact", "left_down", "right_pass", "right_contact", "right_down", "left_pass"]
    },
    "run": {
      "frames": 8,
      "loop": true,
      "phases": [
        "right_contact", "right_compress", "left_drive", "flight_a",
        "left_contact", "left_compress", "right_drive", "flight_b"
      ]
    },
    "brake": {
      "frames": 4,
      "loop": false,
      "phases": ["plant", "counterlean", "compression", "recover"]
