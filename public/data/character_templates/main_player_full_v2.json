{
  "schema": 1,
  "id": "main_player_full_v2",
  "role": "player",
  "status": "generation_target",
  "extends": "data/character_templates/main_player_core_v2.json",
  "purpose": "Target protagonista arcade: poche pose chiave ad alta leggibilità, combo complete e timing variabile",
  "raster": {
    "canvas": [640, 420],
    "baseline_y": 400,
    "scale_mode": "baked",
    "runtime_scale": 1.0,
    "preview_fps": 12
  },
  "direction_policy": {
    "logical_directions": 8,
    "authored_clips": ["walk", "run"],
    "vertical_and_diagonal": "reuse side-facing clip and preserve last horizontal combat facing",
    "allow_runtime_stretch": false
  },
  "required_clips": [
    "idle", "idle_variant_1", "walk", "run", "brake", "jump", "land",
    "air_attack", "air_punch", "punch_left", "punch_right", "combo_finisher",
    "kick_front", "kick_right", "kick_finisher", "block", "grab", "grab_strike",
    "throw", "super", "hit", "knockdown", "getup", "dead"
  ],
  "locomotion": {
    "idle": { "frames": 4, "loop": true },
    "walk": { "frames": 6, "loop": true },
    "run": { "frames": 6, "loop": true },
    "brake": { "frames": 4, "loop": false },
    "jump": { "frames": 8, "loop": false },
    "land": { "frames": 4, "loop": false }
  },
  "clip_targets": {
    "four_hit_punch_combo_total": { "minimum_frames": 16 },
    "kick_combo_total": { "minimum_frames": 12 },
    "aerial_attack": { "minimum_frames": 6 },
    "grab_and_throw_total": { "minimum_frames": 10 },
    "super": { "minimum_frames": 8 },
    "hit": { "minimum_frames": 3 },
    "knockdown": { "minimum_frames": 8 },
    "getup": { "minimum_frames": 8 },
    "dead": { "minimum_frames": 8 }
  },
  "personality_idles": {
    "required_count": 1,
    "optional_expansion_count": 3,
    "minimum_frames_each": 8,
    "maximum_frames_each": 12,
    "duration_seconds": [2.5, 5.0],
    "must_return_to_base_idle": true,
    "allow_frame_blend": false
  },
  "mandatory_transitions": [
    "idle_to_walk", "walk_to_idle", "walk_to_run", "run_to_brake",
    "run_to_jump", "jump_to_air_attack", "jump_to_land", "land_to_idle",
    "hit_to_knockdown", "knockdown_to_getup", "getup_to_idle"
  ],
  "qa": {
    "runtime_scale_locked": 1.0,
    "locked_scale_clips": ["knockdown", "getup", "dead"],
    "reject_exact_duplicates": true,
    "reject_near_duplicates": true,
    "reject_canvas_crop": true,
    "reject_bottom_opaque_cut": true,
    "max_upright_height_error_px": 6,
    "require_first_last_pose_compatibility": true
  }
}
