{
  "schema": 1,
  "id": "main_player_core_v2",
  "role": "player",
  "purpose": "Base runtime riutilizzabile per protagonisti Full V3 con locomozione completa, combattimento e reazioni coerenti",
  "raster": {
    "canvas": [640, 420],
    "baseline_y": 400,
    "scale_mode": "baked",
    "uniform_runtime_scale_only": true
