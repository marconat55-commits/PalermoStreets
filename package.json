{
  "name": "palermo-streets-pixijs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "check": "npm run content:check && npm run validate:data && npm run validate:art && npm run test && npm run typecheck && npm run build",
    "content:check": "node scripts/content/check-content.mjs",
    "content:build": "node scripts/content/build-content.mjs",
    "content:scaffold": "node scripts/content/scaffold-content.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:art": "node scripts/validate-character-art.mjs",
    "test": "node --experimental-strip-types --test"
  },
  "dependencies": {
    "pixi.js": "8.19.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
