{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palermostreets.local/schemas/content-manifest.schema.json",
  "title": "Palermo Streets content manifest",
  "type": "object",
  "required": ["schema", "kind", "id", "status"],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "enum": ["campaign", "character", "stage", "stage_module", "object", "ambient_actor"] },
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
    "status": { "enum": ["draft", "storyboard", "greybox", "pilot", "approved", "integrated", "legacy_integrated"] }
  },
  "additionalProperties": true
}
